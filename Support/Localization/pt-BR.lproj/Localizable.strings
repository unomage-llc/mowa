/* Sponsor prompt */
"Like Mowa? Support it!" = "Gosta do Mowa? Apoie!";
"Mowa is free, with no ads or subscriptions. If it saves you time, you can support its development." = "O Mowa é gratuito, sem anúncios nem assinaturas. Se ele economiza seu tempo, você pode apoiar o desenvolvimento.";
"Support Mowa" = "Apoiar o Mowa";
"One model does all the cleanup: dictation, voice commands on selected text and translation. Faster models are less accurate, more accurate ones are slower. Only models this Mac has enough memory for are listed." = "Um único modelo faz toda a limpeza: ditado, comandos de voz no texto selecionado e tradução. Modelos mais rápidos são menos precisos, e os mais precisos são mais lentos. Só aparecem os modelos para os quais este Mac tem memória suficiente.";
"Fastest, least accurate." = "O mais rápido, o menos preciso.";
"Fast, good accuracy. Used by default on Macs with 8 GB." = "Rápido, boa precisão. Padrão em Macs com 8 GB.";
"More accurate. Used by default on Macs with 16 GB or more." = "Mais preciso. Padrão em Macs com 16 GB ou mais.";
"Most accurate in every language, and fast. Uses about 18 GB of memory." = "O mais preciso em todos os idiomas, e rápido. Usa cerca de 18 GB de memória.";
"Model on a server" = "Modelo em um servidor";
"Use the model on this server" = "Usar o modelo deste servidor";
"Server address" = "Endereço do servidor";
"Model name" = "Nome do modelo";
"API key (optional)" = "Chave de API (opcional)";
"Test connection" = "Testar conexão";
"Connected." = "Conectado.";
"Enter the server address and model name first." = "Primeiro informe o endereço do servidor e o nome do modelo.";
"Any server with an OpenAI-compatible API (Ollama, LM Studio, llama.cpp, vLLM). Your dictated text is sent to this server, so it no longer stays on this Mac. Use https:// for servers outside your local network." = "Qualquer servidor com uma API compatível com a OpenAI (Ollama, LM Studio, llama.cpp, vLLM). O texto ditado é enviado para este servidor, então ele não fica mais só neste Mac. Use https:// para servidores fora da sua rede local.";
"The server's reply wasn't understood. It must support the OpenAI chat completions API." = "A resposta do servidor não foi entendida. Ele precisa ser compatível com a API chat completions da OpenAI.";
"The server answered with error %d." = "O servidor respondeu com o erro %d.";
"Speech recognition runs on your Mac. Cleanup runs on your server." = "O reconhecimento de fala roda no seu Mac. A limpeza roda no seu servidor.";
"That took too long, so Mowa stopped. Please try again." = "Demorou demais, então o Mowa parou. Tente de novo.";
"You're up to date!" = "Você está atualizado!";
"Mowa %@ is currently the newest version available." = "O Mowa %@ é a versão mais recente disponível.";
"Couldn't check for updates." = "Não foi possível verificar atualizações.";
"Please try again later." = "Tente novamente mais tarde.";
"OK" = "OK";

/* Intel Macs (llama.cpp) */
"Use a model file on this Mac (.gguf)…" = "Usar um arquivo de modelo deste Mac (.gguf)…";
"Speech models must be whisper.cpp model files (ggml-….bin). Cleanup models must be GGUF files (.gguf)." = "Modelos de voz devem ser arquivos de modelo do whisper.cpp (ggml-….bin). Modelos de limpeza devem ser arquivos GGUF (.gguf).";
"Use a model file on this Mac (ggml .bin)…" = "Usar um arquivo de modelo deste Mac (ggml .bin)…";
"This Mac's processor is too old for Mowa's on-device models (they need AVX2, found in Intel Macs from 2013 on)." = "O processador deste Mac é antigo demais para os modelos locais do Mowa (eles exigem AVX2, presente nos Macs Intel desde 2013).";
"Write in my keyboard's language" = "Escrever no idioma do meu teclado";
"Speak any language, and the text is typed in the language of your keyboard layout." = "Fale em qualquer idioma e o texto será digitado no idioma do layout do seu teclado.";

/* Noise reduction + voice filter */
"Allow the microphone first." = "Primeiro permita o acesso ao microfone.";
"Cleans up noisy recordings (a fan, traffic, a café) before recognition. Quiet recordings are left as they are." = "Limpa gravações com ruído (ventilador, trânsito, café) antes do reconhecimento. Gravações silenciosas ficam como estão.";
