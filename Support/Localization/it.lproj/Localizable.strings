/* Sponsor prompt */
"Like Mowa? Support it!" = "Ti piace Mowa? Sostienila!";
"Mowa is free, with no ads or subscriptions. If it saves you time, you can support its development." = "Mowa è gratuita, senza pubblicità né abbonamenti. Se ti fa risparmiare tempo, puoi sostenerne lo sviluppo.";
"Support Mowa" = "Sostieni Mowa";
"One model does all the cleanup: dictation, voice commands on selected text and translation. Faster models are less accurate, more accurate ones are slower. Only models this Mac has enough memory for are listed." = "Un solo modello si occupa di tutta la pulizia: dettatura, comandi vocali sul testo selezionato e traduzione. I modelli più veloci sono meno precisi, quelli più precisi sono più lenti. Sono elencati solo i modelli per cui questo Mac ha memoria sufficiente.";
"Fastest, least accurate." = "Il più veloce, il meno preciso.";
"Fast, good accuracy. Used by default on Macs with 8 GB." = "Veloce, buona precisione. Predefinito sui Mac con 8 GB.";
"More accurate. Used by default on Macs with 16 GB or more." = "Più preciso. Predefinito sui Mac con 16 GB o più.";
"Most accurate in every language, and fast. Uses about 18 GB of memory." = "Il più preciso in tutte le lingue, e veloce. Usa circa 18 GB di memoria.";
"Model on a server" = "Modello su un server";
"Use the model on this server" = "Usa il modello su questo server";
"Server address" = "Indirizzo del server";
"Model name" = "Nome del modello";
"API key (optional)" = "Chiave API (facoltativa)";
"Test connection" = "Prova connessione";
"Connected." = "Connesso.";
"Enter the server address and model name first." = "Inserisci prima l’indirizzo del server e il nome del modello.";
"Any server with an OpenAI-compatible API (Ollama, LM Studio, llama.cpp, vLLM). Your dictated text is sent to this server, so it no longer stays on this Mac. Use https:// for servers outside your local network." = "Qualsiasi server con un’API compatibile con OpenAI (Ollama, LM Studio, llama.cpp, vLLM). Il testo dettato viene inviato a questo server, quindi non resta più solo su questo Mac. Usa https:// per i server fuori dalla tua rete locale.";
"The server's reply wasn't understood. It must support the OpenAI chat completions API." = "La risposta del server non è stata compresa. Deve supportare l’API chat completions di OpenAI.";
"The server answered with error %d." = "Il server ha risposto con l’errore %d.";
"Speech recognition runs on your Mac. Cleanup runs on your server." = "Il riconoscimento vocale funziona sul tuo Mac. La pulizia avviene sul tuo server.";
"That took too long, so Mowa stopped. Please try again." = "Ci è voluto troppo, quindi Mowa si è fermata. Riprova.";
"You're up to date!" = "Sei aggiornato!";
"Mowa %@ is currently the newest version available." = "Mowa %@ è attualmente la versione più recente disponibile.";
"Couldn't check for updates." = "Impossibile controllare gli aggiornamenti.";
"Please try again later." = "Riprova più tardi.";
"OK" = "OK";

/* Intel Macs (llama.cpp) */
"Use a model file on this Mac (.gguf)…" = "Usa un file di modello su questo Mac (.gguf)…";
"Speech models must be whisper.cpp model files (ggml-….bin). Cleanup models must be GGUF files (.gguf)." = "I modelli vocali devono essere file di modello whisper.cpp (ggml-….bin). I modelli di pulizia devono essere file GGUF (.gguf).";
"Use a model file on this Mac (ggml .bin)…" = "Usa un file di modello su questo Mac (ggml .bin)…";
"This Mac's processor is too old for Mowa's on-device models (they need AVX2, found in Intel Macs from 2013 on)." = "Il processore di questo Mac è troppo vecchio per i modelli locali di Mowa (richiedono AVX2, presente nei Mac Intel dal 2013).";
"Write in my keyboard's language" = "Scrivi nella lingua della mia tastiera";
"Speak any language, and the text is typed in the language of your keyboard layout." = "Parla in qualsiasi lingua e il testo viene scritto nella lingua del layout della tua tastiera.";

/* Noise reduction + voice filter */
"Allow the microphone first." = "Prima consenti l’accesso al microfono.";
"Cleans up noisy recordings (a fan, traffic, a café) before recognition. Quiet recordings are left as they are." = "Ripulisce le registrazioni rumorose (una ventola, il traffico, un bar) prima del riconoscimento. Le registrazioni silenziose restano come sono.";
"Done reading" = "Ho finito di leggere";
"Done — Mowa knows your voice now." = "Fatto — ora Mowa conosce la tua voce.";
"Forget my voice" = "Dimentica la mia voce";
"Ignore other people's voices" = "Ignora le voci delle altre persone";
"Learn my voice" = "Impara la mia voce";
"Learn my voice…" = "Impara la mia voce…";
"Learning your voice…" = "Mowa sta imparando la tua voce…";
"Mowa didn't hear enough speech. Please read the whole text aloud." = "Mowa ha sentito troppo poco parlato. Leggi ad alta voce tutto il testo.";
"Mowa heard more than one voice or a lot of noise. Please try again somewhere quieter." = "Mowa ha sentito più di una voce o molto rumore. Riprova in un posto più tranquillo.";
"Mowa is learning how my voice sounds, so I'm reading this at my usual pace. On Saturday morning it's nice to walk along the river, buy fresh bread and a jar of honey, and then call an old friend. We're meeting at half past four by the green bridge next to the market. If it rains, there's always the little café, a cup of hot tea and a long talk about books, travel and work." = "Mowa sta imparando com’è la mia voce, quindi leggo questo testo al mio ritmo normale. Il sabato mattina è bello passeggiare lungo il fiume, comprare pane fresco e un vasetto di miele, e poi telefonare a un vecchio amico. L’appuntamento è alle quattro e mezza, vicino al ponte verde accanto al mercato. Se piove, resta sempre il piccolo bar, una tazza di tè caldo e una lunga chiacchierata su libri, viaggi e lavoro.";
"Mowa learns your voice from a short text you read aloud. When this is on, speech that doesn't sound like you — a colleague, a TV — is left out. Works best when people take turns: voices talking over each other can't be separated. Your voiceprint stays on this Mac." = "Mowa impara la tua voce da un breve testo che leggi ad alta voce. Quando questa opzione è attiva, il parlato che non somiglia alla tua voce — un collega, la TV — viene escluso. Funziona meglio quando si parla a turno: voci che parlano insieme non si possono separare. La tua impronta vocale resta su questo Mac.";
"My voice" = "La mia voce";
"Optional. In a noisy place Mowa can ignore other people and type only what you say. Read the text below aloud at your normal pace. Your voiceprint stays on this Mac — you can also do this later in Settings." = "Facoltativo. In un posto rumoroso Mowa può ignorare le altre persone e scrivere solo quello che dici tu. Leggi ad alta voce il testo qui sotto al tuo ritmo normale. La tua impronta vocale resta su questo Mac — puoi farlo anche più tardi nelle Impostazioni.";
"Read at your normal pace and volume, then click Done reading." = "Leggi al tuo ritmo e volume normali, poi fai clic su «Ho finito di leggere».";
"Read the text below aloud at your normal pace." = "Leggi ad alta voce il testo qui sotto al tuo ritmo normale.";
