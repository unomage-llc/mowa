/* Noise reduction + voice filter */
"Allow the microphone first." = "Najpierw zezwól na dostęp do mikrofonu.";
"Cleans up noisy recordings (a fan, traffic, a café) before recognition. Quiet recordings are left as they are." = "Oczyszcza zaszumione nagrania (wentylator, ulica, kawiarnia) przed rozpoznawaniem mowy. Ciche nagrania zostają bez zmian.";
"Done reading" = "Koniec czytania";
