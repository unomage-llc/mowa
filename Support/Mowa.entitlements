<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: allow microphone capture. Mowa is not sandboxed because
	     it must post the paste keystroke into other apps (Accessibility). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
